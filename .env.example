# Пример конфигурации окружения. Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env
# Файл .env не коммитится в репозиторий.

APP_VERSION=dev
HTTP_PORT=80

# --- PostgreSQL ---
AUTH_DB_NAME=AuthDb
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=change-me
COMPVAC_DB_NAME=CompVacDb
COMPVAC_DB_USERNAME=postgres
COMPVAC_DB_PASSWORD=change-me

# --- Масштабирование ---
AUTH_REPLICAS=2
COMPVAC_REPLICAS=2

# --- Безопасность ---
# Общий секрет для подписи JWT (одинаковый для auth-service и company-vacancy-service), минимум 32 символа
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
# Администратор, создаваемый при первом запуске
ADMIN_LOGIN=admin@example.com
ADMIN_PASSWORD=change-me

# --- Фронтенд ---
# Пусто = запросы к API идут на тот же адрес, что и сайт (через nginx)
NEXT_PUBLIC_API_URL=
# Адрес сайта для ссылок в письмах
FRONTEND_URL=http://localhost

# --- Yandex Object Storage (S3) для изображений резюме ---
YC_ACCESS_KEY=
YC_SECRET_KEY=
YC_BUCKET_NAME=
YC_REGION=ru-central1

# --- SMTP для уведомлений ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Только для docker-compose.observability.yml ---
GRAYLOG_PASSWORD_SECRET=change-me-at-least-16-chars
# SHA-256 от пароля администратора Graylog (здесь: "admin")
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
