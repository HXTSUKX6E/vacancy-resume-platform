<?xml version="1.0" encoding="UTF-8"?>
<!--
    Логи пишутся как поток событий в stdout (12 факторов, XI).
    Сбор и маршрутизация логов - задача окружения. Для отправки в Graylog
    включите профиль graylog (SPRING_PROFILES_ACTIVE=graylog) и задайте GRAYLOG_HOST.
-->
<configuration>
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="unknown"/>
    <springProperty name="GRAYLOG_HOST" source="GRAYLOG_HOST" defaultValue="graylog"/>
    <springProperty name="GRAYLOG_PORT" source="GRAYLOG_PORT" defaultValue="12202"/>
    <springProperty name="APP_ENV" source="APP_ENV" defaultValue="dev"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [${APP_NAME}] [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <springProfile name="graylog">
        <appender name="GELF" class="de.siegmar.logbackgelf.GelfUdpAppender">
            <graylogHost>${GRAYLOG_HOST}</graylogHost>
            <graylogPort>${GRAYLOG_PORT}</graylogPort>
            <encoder class="de.siegmar.logbackgelf.GelfEncoder">
                <includeRawMessage>false</includeRawMessage>
                <includeMarker>true</includeMarker>
                <includeMdcData>true</includeMdcData>
                <staticField>app_name:${APP_NAME}</staticField>
                <staticField>environment:${APP_ENV}</staticField>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="GELF"/>
        </root>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
